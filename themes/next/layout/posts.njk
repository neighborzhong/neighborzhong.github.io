{% extends '_layout.njk' %}

{% block title %}文章 | {{ title }}{% endblock %}

{% block class %}posts-list{% endblock %}

{% block content %}
  <h1 class="posts-page-title">全部文章</h1>
  <div class="posts-grid">
    {%- for post in page.posts %}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <div class="post-card-left">
        <div class="post-card-date">
          <span class="post-card-day">{{ post.date.format('DD') }}</span>
          <span class="post-card-month">{{ post.date.format('YYYY年MM月') }}</span>
        </div>
      </div>
      <div class="post-card-right">
        <h2 class="post-card-title">{{ post.title }}</h2>
        <div class="post-card-excerpt">{{ post.excerpt or (post.content | striptags | truncate(120)) }}</div>
        <div class="post-card-meta">
          <span class="post-card-date-inline"><i class="fa fa-calendar"></i> {{ post.date.format('YYYY-MM-DD') }}</span>
          {%- for tag in post.tags.toArray() %}
          <span class="post-card-tag"><i class="fa fa-tag"></i> {{ tag.name }}</span>
          {%- endfor %}
        </div>
      </div>
    </a>
    {%- endfor %}
  </div>
{% endblock %}